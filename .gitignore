# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

# Secrets — never commit credentials
.env
*.token

# Experiment outputs.
#
# results/full is COMMITTED. It is 148 KB of CSV and it is the evidence behind
# every number in the README -- a claim that "every figure traces to committed
# output" is only true if the output is actually in the repository. An earlier
# `results/**` rule excluded all of it, and the `!results/**/manifest.json`
# negation beneath it silently did nothing, because git cannot re-include a file
# inside an excluded directory.
#
# results/demo is committed too: it holds the sample decision card the README
# points at, so a reader can see one without running anything.
#
# Partial and scratch sweeps stay out - they are not what any published number
# cites, and committing them would blur which file is the evidence.
results/scratch/**
results/quick/**
results/e3-quick/**
results/e5-standalone/**
!results/**/.gitkeep

# Generated data (generators + fixtures are committed, bulk output is not)
data/processed/**
!data/processed/.gitkeep
data/raw/synthetic/**
!data/raw/synthetic/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Frontend
# Unanchored: a tool run from the repo root rather than frontend/ drops a stray
# node_modules here, and a path-specific rule does not catch it.
node_modules/
frontend/.next/
frontend/out/
frontend/.env.local

# Playwright run artifacts. Written on every failing run, and unanchored for the
# same reason as node_modules above — the output directory follows the config's
# location, not the repo root.
test-results/
playwright-report/
blob-report/

# Vercel CLI link state and pulled environment values. `.env.example` is the
# committed template and must stay tracked.
.vercel
.env*
# Explicit, because `.env*` above would otherwise swallow it. Without this the
# template survives only by a negation in frontend/.gitignore, which is a fragile
# thing for a committed file to depend on.
!.env.example
