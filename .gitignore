# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

# Secrets — never commit credentials
.env
*.token

# Experiment outputs (regenerated by `make reproduce`; manifests are committed)
results/**
!results/.gitkeep
!results/**/manifest.json

# Generated data (generators + fixtures are committed, bulk output is not)
data/processed/**
!data/processed/.gitkeep
data/raw/synthetic/**
!data/raw/synthetic/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local

# Vercel CLI link state and pulled environment values. `.env.example` is the
# committed template and must stay tracked.
.vercel
.env
.env.local
.env.*.local
