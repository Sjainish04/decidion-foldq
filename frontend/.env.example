# Base URL of the FoldQ API. The local default matches `make api`, which uses
# 8010 because 8000 is commonly occupied. In production point this at your
# deployed API, e.g. https://<user>-foldq-api.hf.space
#
# Only live folding and the PDB structure views need this. The Analytics Lab,
# the dashboard and saved reports read data bundled at build time and render
# with the API absent.
NEXT_PUBLIC_API_URL=http://localhost:8010
